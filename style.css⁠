:root {
    --bg-panel: #0f172a;
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --accent: #0ea5e9;
    --border: #1e293b;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Inter', sans-serif;
    color: var(--text-main);
    overflow: hidden;
    background: #000;
}

#map {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1;
}

.ui-panel {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    z-index: 10;
    width: 380px;
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all 0.3s ease;
}

.header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--border);
}

.header h1 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.25rem;
    letter-spacing: -0.5px;
}

.header p {
    color: var(--text-muted);
    font-size: 0.85rem;
}

.search-box {
    padding: 1.2rem;
    display: flex;
    gap: 0.5rem;
    border-bottom: 1px solid var(--border);
}

input {
    flex-grow: 1;
    padding: 0.75rem 1rem;
    background: #020617;
    border: 1px solid var(--border);
    color: var(--text-main);
    border-radius: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s;
}

input:focus {
    border-color: var(--accent);
}

button {
    background: var(--accent);
    color: #0f172a;
    border: none;
    padding: 0 1.2rem;
    border-radius: 6px;
    font-weight: 600;
    font-family: 'Inter', sans-serif;
    cursor: pointer;
    transition: opacity 0.2s;
}

button:hover {
    opacity: 0.9;
}

.results {
    padding: 0;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, padding 0.4s ease;
}

.results.active {
    padding: 1.5rem;
    max-height: 400px;
    border-bottom: 1px solid var(--border);
}

.result-item {
    margin-bottom: 1rem;
}

.result-item:last-child {
    margin-bottom: 0;
}

.result-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
    font-weight: 600;
}

.result-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.95rem;
    font-weight: 400;
    color: #fff;
}

.error-msg {
    color: #ef4444;
    font-size: 0.9rem;
}

.footer {
    padding: 1rem;
    text-align: center;
    font-size: 0.8rem;
    background: rgba(2, 6, 23, 0.5);
}

.footer a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
}

.footer a:hover {
    color: var(--accent);
}

.custom-marker {
    background: var(--accent);
    border-radius: 50%;
    border: 2px solid #fff;
    box-shadow: 0 0 15px var(--accent);
}

@media (max-width: 600px) {
    .ui-panel {
        top: auto;
        bottom: 0;
        left: 0;
        width: 100vw;
        border-radius: 16px 16px 0 0;
    }
    #map {
        height: calc(100vh - 200px);
    }
}
